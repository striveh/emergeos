  "requiredConstraints": [
    "control 与 drift 使用完全相同的 principal、Capture、Task、Run、Artifact、时间和组件版本，只改变注册 Worker 的 context-policy version",
    "Conductor 只能调用一个固定名称、depth=1、serial、read-only Worker，Worker 只能执行 capture.read",
    "WorkerResult 必须与 child Task、child Run、content hash、evidence refs 和 child Bundle 完整性绑定，只有 parent 可以提交 Artifact",
    "每个 case 必须用 fresh runner 执行两次并得到完全相同的 typed observation"
  ],
  "forbiddenActions": [
    "访问真实模型、互联网、HTTP endpoint、Connector、真实用户数据或真实账号",
    "让 Worker 创建 Artifact、Action、Receipt、Checkpoint、再次 handoff 或执行 write-capable Tool",
    "在 context-policy drift 时创建 child Run、调用 child Model、读取 delegated Capture 或产生 WorkerResult",
    "把本 Pack 宣称为 parallel multi-agent、checkpoint/resume、自动恢复 RUNNING parent 或 exactly-once 外部行动证据"
  ],
  "acceptanceChecks": [
    "control 产生一个 SUCCEEDED parent、一个 SUCCEEDED child、一个 verified WorkerResult 和且仅一个 parent Artifact",
    "control 的 parent/child Task、Trace、Bundle、WorkerResult 与 Artifact hashes 匹配冻结回执及 Pack007 contract graph",
    "drift 在 parent 第一次 WorkerCall 后以 BLOCKED/HANDOFF_CONTEXT_POLICY_DRIFT 结束，且没有 child、WorkerResult 或 Artifact",
    "control 与 drift 共享同一个 parent Task hash；drift 只留下安全的 MODEL_STEP 与 HANDOFF_REJECTED Trace",
    "两个 fresh runner 对每个 case 的完整 observation exact-equal"
  ],
  "humanReviewQuestions": [
    "证据是否证明 Worker 的权限、depth、Tool 和输出绑定均由 server-owned profile 决定，而非由 Model 自报？",
    "context-policy drift 是否在任何 delegated read 和 child persistence 之前 fail-closed？",
    "回执是否清楚区分 deterministic Fake product-path evidence 与真实模型质量、真实用户价值？"
  ],
  "risk": "REVERSIBLE",
  "expectedArtifactKind": "ARTICLE_DRAFT",
  "faultPlan": [
