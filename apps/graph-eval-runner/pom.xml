<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.emergeos</groupId>
    <artifactId>emerge-os</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>emerge-graph-eval-runner</artifactId>
  <name>EmergeOS · Durable Graph Eval Runner</name>

  <dependencies>
    <dependency>
      <groupId>io.emergeos</groupId>
      <artifactId>emerge-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.emergeos</groupId>
      <artifactId>emerge-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.emergeos</groupId>
      <artifactId>emerge-adapter-agent-loop</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.emergeos</groupId>
      <artifactId>emerge-adapter-openai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.emergeos</groupId>
      <artifactId>emerge-adapter-postgres</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <version>${openai-java.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>isolate-durable-graph-eval-runner</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.emergeos:emerge-api</exclude>
                    <exclude>io.emergeos:emerge-eval-runner</exclude>
                    <exclude>io.emergeos:emerge-offline-harness-runner</exclude>
                    <exclude>io.emergeos:emerge-adapter-inmemory</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-web</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-actuator</exclude>
                    <exclude>org.springframework:spring-web*</exclude>
                    <exclude>io.temporal:*</exclude>
                    <exclude>org.hibernate:*</exclude>
                    <exclude>org.langchain4j:*</exclude>
                    <exclude>dev.langchain4j:*</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                  <message>
                    The Durable Graph Eval Runner may compose the exact model and
                    PostgreSQL adapters, but must stay outside product API, other
                    Apps, in-memory product wiring, Web servers, workflow engines
                    and upper-layer Agent frameworks.
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>allow-reviewed-direct-dependencies-only</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*:*</exclude>
                  </excludes>
                  <includes>
                    <include>io.emergeos:emerge-contracts</include>
                    <include>io.emergeos:emerge-core</include>
                    <include>io.emergeos:emerge-adapter-agent-loop</include>
                    <include>io.emergeos:emerge-adapter-openai</include>
                    <include>io.emergeos:emerge-adapter-postgres</include>
                    <include>com.openai:openai-java</include>
                    <include>com.fasterxml.jackson.core:jackson-databind</include>
                    <include>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</include>
                    <include>org.springframework:spring-jdbc</include>
                    <include>org.flywaydb:flyway-core</include>
                    <include>org.flywaydb:flyway-database-postgresql</include>
                    <include>org.postgresql:postgresql</include>
                    <include>org.slf4j:slf4j-nop</include>
                    <include>org.junit.jupiter:junit-jupiter</include>
                    <include>org.testcontainers:testcontainers-junit-jupiter</include>
                    <include>org.testcontainers:testcontainers-postgresql</include>
                  </includes>
                  <searchTransitive>false</searchTransitive>
                  <message>
                    The Durable Graph Eval Runner may add a direct dependency
                    only after its exact coordinate is reviewed here.
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <emerge.graph.repo>${maven.multiModuleProjectDirectory}</emerge.graph.repo>
            <emerge.graph.classes>${project.build.outputDirectory}</emerge.graph.classes>
            <emerge.graph.testClasses>${project.build.testOutputDirectory}</emerge.graph.testClasses>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>app</shadedClassifierName>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/LICENSE.txt</exclude>
                    <exclude>META-INF/LICENSE.md</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.emergeos.grapheval.GraphEvalMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <emerge.graph.it.jar>${project.build.directory}/${project.build.finalName}-app.jar</emerge.graph.it.jar>
            <emerge.graph.it.repo>${maven.multiModuleProjectDirectory}</emerge.graph.it.repo>
            <emerge.graph.it.testClasses>${project.build.testOutputDirectory}</emerge.graph.it.testClasses>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
