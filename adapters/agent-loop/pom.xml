<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.emergeos</groupId>
    <artifactId>emerge-os</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>emerge-adapter-agent-loop</artifactId>
  <name>EmergeOS · Provider-neutral Agent Loop</name>

  <dependencies>
    <dependency>
      <groupId>io.emergeos</groupId>
      <artifactId>emerge-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>keep-agent-loop-provider-neutral</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>io.temporal:*</exclude>
                    <exclude>org.hibernate.orm:*</exclude>
                    <exclude>org.postgresql:*</exclude>
                    <exclude>com.openai:*</exclude>
                    <exclude>dev.langchain4j:*</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                  <message>The Agent loop may depend on Core contracts, not provider SDKs, runtimes or infrastructure.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
