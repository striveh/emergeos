<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.emergeos</groupId>
    <artifactId>emerge-os</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>emerge-adapter-openai</artifactId>
  <name>EmergeOS · OpenAI Responses Adapter</name>

  <dependencies>
    <dependency>
      <groupId>io.emergeos</groupId>
      <artifactId>emerge-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.emergeos</groupId>
      <artifactId>emerge-adapter-agent-loop</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <version>${openai-java.version}</version>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>${okhttp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>isolate-openai-adapter</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>io.temporal:*</exclude>
                    <exclude>org.postgresql:*</exclude>
                    <exclude>org.langchain4j:*</exclude>
                    <exclude>io.emergeos:emerge-api</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                  <message>The OpenAI adapter must remain isolated from API, workflow, database and Agent frameworks.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
