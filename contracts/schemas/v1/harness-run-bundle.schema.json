{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emergeos:schema:v1:harness-run-bundle",
  "title": "HarnessRunBundle",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "safeText2048": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^\\u0000]*$"
    },
    "safeName200": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^\\u0000]*$"
    },
    "safeModel512": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^\\u0000]*$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "taskId",
    "experiment",
    "modelResolved",
    "harnessVersion",
    "componentVersions",
    "environmentSnapshotRef",
    "toolRegistryVersion",
    "task",
    "result",
    "workingSelfRef",
    "traceRef",
    "traceRootHash",
    "handoffRefs",
    "checkpointRefs",
    "resourceBindings",
    "verificationRef",
    "failureAttribution",
    "outcome",
    "costUsd",
    "tokenCount",
    "latencyMs",
    "integrityProfile",
    "integrityHash"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "experiment": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["arm", "repetition"],
          "properties": {
            "arm": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^\\u0000]*$"
            },
            "repetition": {"type": "integer", "minimum": 1, "maximum": 1000000}
          }
        }
      ]
    },
    "modelResolved": {
      "oneOf": [{"$ref": "#/$defs/safeModel512"}, {"type": "null"}]
    },
    "harnessVersion": {"$ref": "#/$defs/safeName200"},
    "componentVersions": {
      "type": "object",
      "required": ["agent", "verifier", "trace-integrity"],
      "properties": {
        "agent": {"$ref": "#/$defs/safeName200"},
        "verifier": {"$ref": "#/$defs/safeName200"},
        "trace-integrity": {"$ref": "#/$defs/safeName200"}
      },
      "propertyNames": {"$ref": "#/$defs/safeName200"},
      "additionalProperties": {"$ref": "#/$defs/safeName200"}
    },
    "environmentSnapshotRef": {
      "oneOf": [{"$ref": "#/$defs/safeText2048"}, {"type": "null"}]
    },
    "toolRegistryVersion": {"$ref": "#/$defs/safeName200"},
    "task": {"$ref": "urn:emergeos:schema:v1:task-envelope"},
    "result": {"$ref": "urn:emergeos:schema:v1:result-envelope"},
    "workingSelfRef": {
      "oneOf": [{"$ref": "#/$defs/safeText2048"}, {"type": "null"}]
    },
    "traceRef": {
      "type": "string",
      "pattern": "^/api/v1/agent-runs/[A-Za-z0-9][A-Za-z0-9._~-]{0,127}/trace$"
    },
    "traceRootHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "handoffRefs": {"type": "array", "items": {"$ref": "#/$defs/safeText2048"}},
    "checkpointRefs": {"type": "array", "items": {"$ref": "#/$defs/safeText2048"}},
    "resourceBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"role": {"const": "EVIDENCE"}}},
            "then": {
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^capture://[A-Za-z0-9][A-Za-z0-9._~-]{0,199}$"
                }
              }
            }
          },
          {
            "if": {"properties": {"role": {"const": "ARTIFACT"}}},
            "then": {
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^artifact-version://[A-Za-z0-9][A-Za-z0-9._~-]{0,127}/[1-9][0-9]*$"
                }
              }
            }
          }
        ],
        "required": ["role", "ordinal", "ref", "contentHash"],
        "properties": {
          "role": {
            "enum": [
              "EVIDENCE",
              "ARTIFACT",
              "RECEIPT",
              "VERIFICATION",
              "CHECKPOINT",
              "HANDOFF"
            ]
          },
          "ordinal": {"type": "integer", "minimum": 0, "maximum": 127},
          "ref": {"$ref": "#/$defs/safeText2048"},
          "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "verificationRef": {
      "oneOf": [{"$ref": "#/$defs/safeText2048"}, {"type": "null"}]
    },
    "failureAttribution": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "outcome": {"enum": ["SUCCEEDED", "FAILED", "NEEDS_INPUT", "BLOCKED", "CANCELLED"]},
    "costUsd": {
      "type": "number",
      "minimum": 0,
      "maximum": 999999.999999,
      "multipleOf": 0.000001
    },
    "tokenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latencyMs": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "integrityProfile": {"const": "emergeos-length-prefixed-sha256-v1"},
    "integrityHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
