{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emergeos:schema:v1:harness-run-bundle",
  "title": "HarnessRunBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "taskId",
    "experimentArm",
    "repetition",
    "modelResolved",
    "harnessVersion",
    "componentVersions",
    "environmentSnapshotRef",
    "toolRegistryVersion",
    "task",
    "workingSelfRef",
    "traceRefs",
    "handoffRefs",
    "checkpointRefs",
    "artifactRefs",
    "receiptRefs",
    "verificationRef",
    "outcome",
    "costUsd",
    "tokenCount",
    "latencyMs",
    "integrityHash"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "runId": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "experimentArm": {"type": "string", "minLength": 1},
    "repetition": {"type": "integer", "minimum": 1},
    "modelResolved": {"type": "string", "minLength": 1},
    "harnessVersion": {"type": "string", "minLength": 1},
    "componentVersions": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "environmentSnapshotRef": {"type": "string", "minLength": 1},
    "toolRegistryVersion": {"type": "string", "minLength": 1},
    "task": {"$ref": "urn:emergeos:schema:v1:task-envelope"},
    "workingSelfRef": {"type": "string", "minLength": 1},
    "traceRefs": {"type": "array", "items": {"type": "string"}},
    "handoffRefs": {"type": "array", "items": {"type": "string"}},
    "checkpointRefs": {"type": "array", "items": {"type": "string"}},
    "artifactRefs": {"type": "array", "items": {"type": "string"}},
    "receiptRefs": {"type": "array", "items": {"type": "string"}},
    "verificationRef": {"type": "string", "minLength": 1},
    "failureAttribution": {"type": ["string", "null"]},
    "outcome": {"enum": ["SUCCEEDED", "FAILED", "NEEDS_INPUT", "BLOCKED", "CANCELLED"]},
    "costUsd": {"type": "number", "minimum": 0},
    "tokenCount": {"type": "integer", "minimum": 0},
    "latencyMs": {"type": "integer", "minimum": 0},
    "integrityHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
