{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emergeos:schema:v1:task-envelope",
  "title": "TaskEnvelope",
  "type": "object",
  "additionalProperties": false,
  "$comment": "The id != parentId invariant requires the cross-language semantic validator; standard JSON Schema 2020-12 cannot portably compare sibling property values.",
  "$defs": {
    "safeText2048": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^\\u0000]*$"
    },
    "safeName200": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^\\u0000]*$"
    },
    "safeModel512": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~:/-]{0,511}$"
    },
    "id128": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "parentId",
    "principalRef",
    "delegationChain",
    "kind",
    "intent",
    "inputRefs",
    "evidenceRefs",
    "modalities",
    "dataClass",
    "risk",
    "latencyClass",
    "requiredTools",
    "outputSchema",
    "acceptanceChecks",
    "allowParallel",
    "maxModelSteps",
    "maxToolCalls",
    "deadlineMs",
    "budgetUsd",
    "idempotencyKey",
    "policyVersion",
    "stateVersion",
    "contextPolicyVersion",
    "toolRegistryVersion",
    "environmentSnapshotRef",
    "capabilityRefs",
    "unresolvedDecisions",
    "returnControlWhen"
  ],
  "properties": {
    "schemaVersion": {"enum": ["1.0", "1.1"]},
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "parentId": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "principalRef": {"$ref": "#/$defs/safeName200"},
    "delegationChain": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id128"}
    },
    "kind": {"$ref": "#/$defs/safeName200"},
    "intent": {"$ref": "#/$defs/safeText2048"},
    "inputRefs": {"type": "array", "items": {"$ref": "#/$defs/safeText2048"}},
    "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/safeText2048"}},
    "modalities": {
      "type": "array",
      "items": {"enum": ["text", "image", "audio", "video"]}
    },
    "dataClass": {"enum": ["PUBLIC", "PERSONAL", "SENSITIVE", "SECRET"]},
    "risk": {"enum": ["READ_ONLY", "REVERSIBLE", "EXTERNAL", "IRREVERSIBLE"]},
    "latencyClass": {"enum": ["REALTIME", "INTERACTIVE", "DEEP", "ASYNC"]},
    "requiredTools": {"type": "array", "items": {"$ref": "#/$defs/safeName200"}},
    "outputSchema": {"$ref": "#/$defs/safeText2048"},
    "acceptanceChecks": {"type": "array", "items": {"$ref": "#/$defs/safeText2048"}},
    "allowParallel": {"type": "boolean"},
    "maxModelSteps": {"type": "integer", "minimum": 1, "maximum": 128},
    "maxToolCalls": {"type": "integer", "minimum": 1, "maximum": 128},
    "deadlineMs": {"type": "integer", "minimum": 1, "maximum": 86400000},
    "budgetUsd": {
      "type": "number",
      "minimum": 0,
      "maximum": 999999.999999,
      "multipleOf": 0.000001
    },
    "modelProvider": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "modelRequested": {
      "oneOf": [{"$ref": "#/$defs/safeModel512"}, {"type": "null"}]
    },
    "pricingProfile": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9._-]{0,199}$"
    },
    "idempotencyKey": {
      "oneOf": [{"$ref": "#/$defs/safeName200"}, {"type": "null"}]
    },
    "policyVersion": {"$ref": "#/$defs/safeName200"},
    "stateVersion": {"$ref": "#/$defs/safeName200"},
    "contextPolicyVersion": {"$ref": "#/$defs/safeName200"},
    "toolRegistryVersion": {"$ref": "#/$defs/safeName200"},
    "environmentSnapshotRef": {
      "oneOf": [{"$ref": "#/$defs/safeText2048"}, {"type": "null"}]
    },
    "capabilityRefs": {"type": "array", "items": {"$ref": "#/$defs/safeText2048"}},
    "unresolvedDecisions": {"type": "array", "items": {"$ref": "#/$defs/safeText2048"}},
    "returnControlWhen": {"$ref": "#/$defs/safeText2048"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schemaVersion": {"const": "1.1"}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["modelProvider", "modelRequested", "pricingProfile"],
        "properties": {
          "modelProvider": {"type": "string"},
          "modelRequested": {"$ref": "#/$defs/safeModel512"},
          "pricingProfile": {"type": "string"},
          "idempotencyKey": {"$ref": "#/$defs/safeName200"},
          "environmentSnapshotRef": {
            "type": "string",
            "pattern": "^environment://sha256:[a-f0-9]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "modelProvider": {"type": "null"},
          "modelRequested": {"type": "null"},
          "pricingProfile": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"parentId": {"type": "null"}},
        "required": ["parentId"]
      },
      "then": {
        "properties": {
          "delegationChain": {"type": "array", "maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "delegationChain": {"type": "array", "minItems": 1, "maxItems": 1}
        }
      }
    }
  ]
}
