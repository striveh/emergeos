{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emergeos:schema:v1:task-envelope",
  "title": "TaskEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "principalRef",
    "delegationChain",
    "kind",
    "intent",
    "inputRefs",
    "evidenceRefs",
    "modalities",
    "dataClass",
    "risk",
    "latencyClass",
    "requiredTools",
    "outputSchema",
    "acceptanceChecks",
    "allowParallel",
    "deadlineMs",
    "budgetUsd",
    "policyVersion",
    "stateVersion",
    "contextPolicyVersion",
    "toolRegistryVersion",
    "capabilityRefs",
    "unresolvedDecisions",
    "returnControlWhen"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "parentId": {"type": ["string", "null"]},
    "principalRef": {"type": "string", "minLength": 1},
    "delegationChain": {"type": "array", "items": {"type": "string"}},
    "kind": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "inputRefs": {"type": "array", "items": {"type": "string"}},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}},
    "modalities": {
      "type": "array",
      "items": {"enum": ["text", "image", "audio", "video"]}
    },
    "dataClass": {"enum": ["PUBLIC", "PERSONAL", "SENSITIVE", "SECRET"]},
    "risk": {"enum": ["READ_ONLY", "REVERSIBLE", "EXTERNAL", "IRREVERSIBLE"]},
    "latencyClass": {"enum": ["REALTIME", "INTERACTIVE", "DEEP", "ASYNC"]},
    "requiredTools": {"type": "array", "items": {"type": "string"}},
    "outputSchema": {"type": "string", "minLength": 1},
    "acceptanceChecks": {"type": "array", "items": {"type": "string"}},
    "allowParallel": {"type": "boolean"},
    "deadlineMs": {"type": "integer", "minimum": 1},
    "budgetUsd": {"type": "number", "minimum": 0},
    "idempotencyKey": {"type": ["string", "null"]},
    "policyVersion": {"type": "string", "minLength": 1},
    "stateVersion": {"type": "string", "minLength": 1},
    "contextPolicyVersion": {"type": "string", "minLength": 1},
    "toolRegistryVersion": {"type": "string", "minLength": 1},
    "environmentSnapshotRef": {"type": ["string", "null"]},
    "capabilityRefs": {"type": "array", "items": {"type": "string"}},
    "unresolvedDecisions": {"type": "array", "items": {"type": "string"}},
    "returnControlWhen": {"type": "string", "minLength": 1}
  }
}
