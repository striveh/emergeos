{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emergeos:schema:v1:agent-trace-envelope",
  "title": "AgentTraceEnvelope",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "safeText2048": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^\\u0000]*$"
    },
    "safeName200": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^\\u0000]*$"
    },
    "safeStatus100": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^\\u0000]*$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "taskId",
    "integrityProfile",
    "events",
    "eventCount",
    "rootHash"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "integrityProfile": {"const": "emergeos-length-prefixed-sha256-v1"},
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "type",
          "toolName",
          "status",
          "reference",
          "previousRootHash",
          "eventHash"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "type": {
            "enum": [
              "MODEL_STEP",
              "TOOL_REQUEST",
              "TOOL_RESULT",
              "TOOL_REJECTED",
              "HANDOFF_REQUEST",
              "HANDOFF_RESULT",
              "HANDOFF_REJECTED",
              "STRUCTURED_FINAL",
              "ARTIFACT_COMMITTED"
            ]
          },
          "toolName": {
            "oneOf": [{"$ref": "#/$defs/safeName200"}, {"type": "null"}]
          },
          "status": {"$ref": "#/$defs/safeStatus100"},
          "reference": {
            "oneOf": [{"$ref": "#/$defs/safeText2048"}, {"type": "null"}]
          },
          "previousRootHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "eventHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"type": {"const": "HANDOFF_REQUEST"}},
              "required": ["type"]
            },
            "then": {
              "properties": {
                "toolName": {"type": "null"},
                "status": {"const": "REQUESTED"},
                "reference": {
                  "type": "string",
                  "pattern": "^agent-run://[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {"type": {"const": "HANDOFF_RESULT"}},
              "required": ["type"]
            },
            "then": {
              "properties": {
                "toolName": {"type": "null"},
                "status": {"const": "SUCCEEDED"},
                "reference": {
                  "type": "string",
                  "pattern": "^agent-run://[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {"type": {"const": "HANDOFF_REJECTED"}},
              "required": ["type"]
            },
            "then": {
              "properties": {
                "toolName": {"type": "null"},
                "status": {
                  "enum": [
                    "BLOCKED",
                    "FAILED",
                    "CANCELLED_UNOBSERVED",
                    "DEADLINE_EXHAUSTED",
                    "DEADLINE_EXCEEDED_UNOBSERVED",
                    "DEADLINE_EXCEEDED_AFTER_CHILD",
                    "LIMIT_EXHAUSTED",
                    "CHILD_FAILED",
                    "CHILD_BLOCKED",
                    "CHILD_NEEDS_INPUT",
                    "CHILD_CANCELLED",
                    "MALFORMED_RESULT"
                  ]
                },
                "reference": {
                  "oneOf": [
                    {"type": "null"},
                    {
                      "type": "string",
                      "pattern": "^agent-run://[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {"type": {"const": "STRUCTURED_FINAL"}},
              "required": ["type"]
            },
            "then": {
              "properties": {
                "toolName": {"type": "null"},
                "status": {"const": "PROPOSED"},
                "reference": {
                  "type": "string",
                  "pattern": "^(?:task://[A-Za-z0-9][A-Za-z0-9._~-]{0,127}|proposal://sha256:[a-f0-9]{64})$"
                }
              }
            }
          }
        ]
      }
    },
    "eventCount": {"type": "integer", "minimum": 0, "maximum": 128},
    "rootHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
